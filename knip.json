{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/app/main.tsx",
        "src/domains/actions/public.ts",
        "src/domains/document/public.ts",
        "src/domains/editor/public.ts",
        "scripts/**/*.{mjs,ts}",
        "e2e/**/*.ts",
        "vite.config.ts",
        "vitest.config.ts",
        "playwright.config.ts",
        "playwright.perf.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{ts,mjs}",
        "e2e/**/*.ts",
        "*.config.{ts,js}"
      ]
    },
    "packages/protocol": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/fonts": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/chargraph": {
      "entry": ["src/index.ts", "src/mermaid.ts", "src/**/*.test.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/blackboard": {
      "entry": [
        "src/cli.ts",
        "src/**/*.test.ts",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.ts", "*.config.ts"]
    },
    "apps/docs": {
      "entry": [
        "app/root.tsx",
        "app/routes.ts",
        "app/routes/*.tsx",
        "app/routes/*.ts",
        "react-router.config.ts",
        "vite.config.ts"
      ],
      "project": ["app/**/*.{ts,tsx}", "*.config.ts"]
    },
    "apps/chargraph": {
      "entry": ["src/main.ts", "src/**/*.test.ts", "vite.config.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts", "*.config.ts"]
    }
  },
  "include": [
    "files",
    "dependencies",
    "unresolved",
    "exports",
    "types",
    "duplicates"
  ],
  "ignore": [
    "packages/chargraph/src/vendor/**"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css"
  ]
}
