{
  "name": "@chardesk/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Headless CharDesk source renderer and checker",
  "type": "module",
  "bin": {
    "chardesk": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@chardesk/blackboard": "*",
    "@chardesk/chargraph": "*",
    "@chardesk/document": "*",
    "@chardesk/fonts": "*",
    "@chardesk/protocol": "*",
    "@chardesk/rendering": "*",
    "@napi-rs/canvas": "^1.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
