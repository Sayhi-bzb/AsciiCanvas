{
  "name": "@chardesk/blackboard",
  "version": "0.0.0",
  "description": "Local read-only Blackboard for a directly edited CharDesk file",
  "private": true,
  "type": "module",
  "bin": {
    "chardesk-blackboard": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@chardesk/chargraph": "*",
    "@chardesk/document": "*"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
