{
  "name": "@ascii-canvas/fonts",
  "version": "0.1.0",
  "description": "Self-hosted fonts and the default AsciiCanvas renderer font profile",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sayhi-bzb/AsciiCanvas.git",
    "directory": "packages/fonts"
  },
  "homepage": "https://github.com/Sayhi-bzb/AsciiCanvas/tree/main/packages/fonts#readme",
  "bugs": {
    "url": "https://github.com/Sayhi-bzb/AsciiCanvas/issues"
  },
  "keywords": [
    "ascii",
    "canvas",
    "fonts",
    "unicode"
  ],
  "sideEffects": ["./fonts.css"],
  "files": [
    "assets",
    "dist",
    "fonts.css",
    "manifest.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fonts.css": "./fonts.css",
    "./manifest.json": "./manifest.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  }
}
