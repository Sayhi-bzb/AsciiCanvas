{
  "name": "@chardesk/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared CharDesk theme and UI primitives",
  "type": "module",
  "sideEffects": [
    "./theme.css"
  ],
  "files": [
    "dist",
    "theme.css",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "import": "./dist/styles.js"
    },
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.5",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "react": "^19.2.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
