{
  "name": "@chardesk/chargraph",
  "version": "0.1.0",
  "private": true,
  "description": "Pluggable source-to-Unicode rendering for CharDesk",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE.beautiful-mermaid",
    "LICENSE.marked-terminal",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mermaid": {
      "types": "./dist/mermaid.d.ts",
      "import": "./dist/mermaid.js"
    },
    "./markdown": {
      "types": "./dist/markdown-default.d.ts",
      "import": "./dist/markdown-default.js"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@chardesk/protocol": "*",
    "elkjs": "^0.11.1",
    "jsonc-parser": "^3.3.1",
    "marked": "^16.4.1",
    "marked-alert": "^2.1.2",
    "saxes": "^6.0.0",
    "shiki": "^4.4.3",
    "temml": "^0.13.4",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
