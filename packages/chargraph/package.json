{
  "name": "@chardesk/chargraph",
  "version": "0.1.0",
  "private": true,
  "description": "Pluggable source-to-Unicode rendering for CharDesk",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE.beautiful-mermaid",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mermaid": {
      "types": "./dist/mermaid.d.ts",
      "import": "./dist/mermaid.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@chardesk/protocol": "*"
  },
  "engines": {
    "node": ">=18"
  }
}
