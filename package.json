{
  "name": "chardesk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --success first --names app,docs --prefix-colors cyan,magenta \"npm:dev:app\" \"npm:dev:docs\"",
    "dev:app": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:docs": "npm run dev -w @chardesk/docs",
    "build": "npm run build -w @chardesk/fonts && npm run build -w @chardesk/protocol && npm run build -w @chardesk/viewer && npm run build -w @chardesk/blackboard && tsc -b && vite build && npm run build:docs",
    "build:docs": "npm run build -w @chardesk/docs && node scripts/docs/merge-build.mjs && node scripts/docs/verify-build.mjs",
    "typecheck": "tsc -b --pretty false && npm run typecheck -w @chardesk/blackboard && npm run typecheck -w @chardesk/docs",
    "typecheck:docs": "npm run typecheck -w @chardesk/docs",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:character-data": "node scripts/data/generate-character-data.mjs",
    "characters:verify": "node scripts/data/generate-character-data.mjs --verify",
    "fonts:sync": "node scripts/fonts/vendor-fonts.mjs",
    "fonts:verify": "node scripts/fonts/vendor-fonts.mjs --verify",
    "knip": "knip",
    "check-style-api": "node scripts/quality/check-style-api.mjs",
    "check:agent-navigation": "node scripts/quality/run-agent-navigation-benchmark.mjs",
    "test": "vitest",
    "test:fonts": "npm test -w @chardesk/fonts",
    "test:blackboard": "npm test -w @chardesk/blackboard",
    "test:protocol": "npm test -w @chardesk/protocol",
    "test:viewer": "npm test -w @chardesk/viewer",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:perf": "npm run build && node scripts/performance/run-perf.mjs",
    "check:boundaries": "node scripts/check-domain-boundaries.mjs",
    "check:type-escapes": "node scripts/quality/check-type-escapes.mjs",
    "check:state-ownership": "node scripts/quality/check-state-ownership.mjs",
    "check:architecture": "npm run check:boundaries && npm run check:type-escapes && npm run check:state-ownership && npm run check-style-api",
    "verify": "npm run typecheck && npm run lint && npm run knip && npm run check:architecture && npm run test:protocol && npm run test:blackboard && npm test -- --run && npm run build"
  },
  "dependencies": {
    "@chardesk/fonts": "*",
    "@chardesk/protocol": "*",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@use-gesture/react": "^10.3.1",
    "ahooks": "^3.9.6",
    "bresenham": "^0.0.4",
    "clsx": "^2.1.1",
    "driver.js": "^1.8.0",
    "immer": "^11.0.1",
    "knip": "^5.73.4",
    "lucide-react": "^1.31.0",
    "motion": "^12.23.26",
    "next-themes": "^0.4.6",
    "polygon-clipping": "^0.15.7",
    "radix-ui": "^1.6.5",
    "react": "^19.2.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.27",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bresenham": "^0.0.3",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fontkit": "^2.0.4",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.2.0",
    "vitest": "^4.1.2"
  }
}
